{
  "manifest_version": 3,
  "name": "USDT Price in TradingView Watchlist",
  "short_name": "USDT Live",
  "version": "1.0.0",
  "description": "Live Tether (USDT) price in Iranian toman from ArzDigital for the TradingView watchlist.",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://tradingview.com/*", "https://www.tradingview.com/*"],
      "js": ["lib/centrifugo.js", "content.js"],
      "css": ["styles/content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "قیمت تتر",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["fonts/Vazirmatn-RD-Regular.woff2", "icons/icon32.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
